<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Reset your openPharmacy password</title>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .button { display: inline-block; background: #2563eb; color: #fff; padding: 12px 24px; border-radius: 6px; text-decoration: none; }
    .muted { color: #666; font-size: 0.9em; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Hello, {{fullName}}</h1>
    <p>We received a request to reset your openPharmacy password.</p>

    <p>Click the button below to set a new password. This link is valid for 24 hours.</p>
    <a href="{{resetUrl}}" class="button">Reset password</a>

    <p class="muted">If the button does not work, paste this URL into your browser:<br>{{resetUrl}}</p>
    <p class="muted">If you did not request a password reset, please ignore this email.</p>
  </div>
</body>
</html>
