# =============================================================================
# openPharmacy API – environment variables template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is git-ignored; only `.env.example` is tracked.
#
# Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================


# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Credentials used by the local docker-compose Postgres service.
POSTGRES_USER=openpharmacy
POSTGRES_PASSWORD=openpharmacy
POSTGRES_DB=openpharmacy
POSTGRES_PORT=5432

# Prisma datasource URL. Must use the same credentials as above.
# In production, point this at your managed Postgres host.
DATABASE_URL=postgresql://openpharmacy:openpharmacy@localhost:5432/openpharmacy?schema=public


# ─── App runtime ────────────────────────────────────────────────────────────
# One of: development | production | test
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# Comma-separated list of origins allowed by CORS. Use the FE dev server in
# dev, your real domain in production. The FE must send credentials.
CORS_ORIGIN=http://localhost:3001


# ─── Cookie signing ─────────────────────────────────────────────────────────
# Used by cookie-parser to sign the refresh-token cookie.
# 8+ chars. Rotate to invalidate every active session at once.
COOKIE_SECRET=change-me-in-production


# ─── Password hashing ───────────────────────────────────────────────────────
# bcrypt cost factor. 12 ≈ 250 ms per hash on a modern CPU.
# Bump to 13+ as hardware gets faster; never go below 10.
BCRYPT_SALT_ROUNDS=12


# ─── JWT (access token) ─────────────────────────────────────────────────────
# 32+ chars. Used to sign and verify short-lived access tokens.
# ROTATE this value to invalidate every outstanding access token.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long

# How long an access token is valid. Accepts ms | s | m | h | d.
# Short-lived (minutes) is the secure default; the ticket specifies 8h.
JWT_ACCESS_TTL=8h


# ─── JWT (refresh token) ────────────────────────────────────────────────────
# 32+ chars. MUST be different from JWT_ACCESS_SECRET so a leaked access
# secret cannot be used to forge refresh tokens (and vice versa).
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long

# How long a refresh token is valid. Accepts ms | s | m | h | d.
# The refresh token is also persisted server-side (hashed jti) and can be
# revoked before expiry; see RefreshToken table.
JWT_REFRESH_TTL=7d


# ─── Account lockout ────────────────────────────────────────────────────────
# Number of consecutive failed login attempts before the account is locked.
LOCKOUT_MAX_ATTEMPTS=5

# How long the account stays locked, in minutes. After this period a new
# attempt resets the counter on the next successful login.
LOCKOUT_DURATION_MIN=15


# ─── Rate limiting (global tiers) ───────────────────────────────────────────
# Three sliding-window tiers enforced by @nestjs/throttler. A request counts
# against all three; it must be under every limit to pass.
#
# short:  per-second cap (burst protection)
# medium: per-10s cap
# long:   per-minute cap

# Window length in milliseconds.
THROTTLE_SHORT_TTL=1000
THROTTLE_MEDIUM_TTL=10000
THROTTLE_LONG_TTL=60000

# Max requests per IP inside the window above.
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_LONG_LIMIT=100


# ─── Rate limiting (login endpoint override) ────────────────────────────────
# POST /auth/login gets stricter per-IP limits on top of the global tiers.
# The lockout policy above is per-account; this one is per-IP.
THROTTLE_LOGIN_TTL=60000
THROTTLE_LOGIN_LIMIT=5


# ─── Mailer / SMTP ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to use the built-in Ethereal test inbox in development.
# In production, set real SMTP credentials and a valid FRONTEND_URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@openpharmacy.com
FRONTEND_URL=http://localhost:3001


# ─── Reporting / export jobs ───────────────────────────────────────────────────
# Reports are generated with ExcelJS (xlsx) and Puppeteer (PDF). Redis is NOT
# used in this deployment, so large reports are queued in the `pharmacy.report_jobs`
# table and drained by an in-process poller (SELECT … FOR UPDATE SKIP LOCKED).

# Requests estimated at <= this many rows are generated synchronously and
# streamed back immediately; larger ones are enqueued and delivered via SSE/email.
REPORT_SYNC_THRESHOLD=2000

# Hard ceiling on the number of rows a single report may export (400 if exceeded).
REPORT_MAX_ROWS=200000

# Maximum allowed date-range length, in days (the ticket caps reports at 1 year).
REPORT_MAX_RANGE_DAYS=366

# Largest generated file we will store in `report_jobs.result_data` (BYTEA).
REPORT_MAX_FILE_BYTES=15728640

# Run the in-process queue worker. Set false on API-only nodes that should not
# drain the queue (e.g. a dedicated worker process owns it).
REPORT_WORKER_ENABLED=true

# How often the worker polls `report_jobs` for claimable work.
REPORT_WORKER_POLL_MS=2000

# Lease seconds a claimed job is held before it can be re-claimed if the worker
# dies mid-run. Should exceed the worst-case generation time.
REPORT_JOB_LEASE_SEC=120

# Days a generated report file is retained before it is considered expired.
REPORT_FILE_TTL_DAYS=7

# Default IANA timezone for date boundaries when a request omits `timezone`.
REPORT_DEFAULT_TIMEZONE=America/La_Paz

# Chromium binary used for PDF exports. Leave empty to auto-detect:
# PUPPETEER_EXECUTABLE_PATH wins, then well-known install paths
# (Chrome/Chromium/Edge), then @sparticuz/chromium on Linux only.
# Needed on Windows/macOS dev machines where sparticuz has no binary.
# Example: PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# Public origin used to build the DOWNLOAD LINK in report emails.
# IMPORTANT: never leave this on localhost. Emails are opened on the customer's
# own computer, so localhost/127.0.0.1 points at THEIR machine and the link
# breaks. Set it to the https URL the app is reached at. The generated link is
# ${base}/api/reports/d/<signed-token>, same-origin to the app (Next rewrites
# /api/* to this API). If empty, falls back to FRONTEND_URL.
# Example prod: https://farmacia.miempresa.com
REPORT_DOWNLOAD_BASE_URL=

# Lifetime (minutes) of the emailed download link. Default 10080 = 7 days.
# Stops working after this or REPORT_FILE_TTL_DAYS, whichever is sooner.
REPORT_DOWNLOAD_TTL_MIN=10080

# Secret used to HMAC-sign emailed download links. Keep it out of source control;
# rotating it invalidates every previously-sent link. Falls back to JWT_ACCESS_SECRET.
REPORT_DOWNLOAD_SECRET=
